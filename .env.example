DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/postgres?schema=public"
# Opsi pool untuk database remote; nilai default aplikasi: 4, 8000, 30000, 30000.
DATABASE_POOL_MAX="4"
DATABASE_CONNECT_TIMEOUT_MS="8000"
DATABASE_QUERY_TIMEOUT_MS="30000"
DATABASE_STATEMENT_TIMEOUT_MS="30000"
NEXT_PUBLIC_DEVICE_AGENT_URL="http://127.0.0.1:4545"
# Endpoint server online yang menerima upload browser fallback setelah print.
NEXT_PUBLIC_SNAPORE_SERVER_URL="https://photobooth.elevore.web.id"
SNAPORE_AGENT_PORT="4545"
SNAPORE_DATA_DIR="./snapore-data"
SNAPORE_SERVER_URL="https://photobooth.elevore.web.id"
# Di server production, arahkan ke folder filesystem yang dipetakan web server ke /uploads/.
SNAPORE_SERVER_UPLOAD_DIR="./public/uploads"
SNAPORE_PUBLIC_UPLOAD_BASE_URL="https://photobooth.elevore.web.id/uploads/"
SNAPORE_PUBLIC_APP_URL="https://photobooth.elevore.web.id"
# Gunakan daftar origin dipisahkan koma untuk pembatasan lebih ketat; * mengizinkan semua kiosk/browser.
SNAPORE_UPLOAD_ALLOWED_ORIGINS="*"
SNAPORE_DEVICE_TOKEN="change-this-device-token"
SNAPORE_PRINTER_MODE="os-spooler"
# PowerShell Windows yang dipakai untuk discovery queue dan silent photo print.
SNAPORE_POWERSHELL_PATH="powershell.exe"
# Opsional: executable adapter vendor dengan command `print` dan argumen pada README.
SNAPORE_DNP_SDK_BRIDGE=""
SNAPORE_EPSON_SDK_BRIDGE=""
# Path executable bridge resmi Canon EDSDK. Kosongkan jika tidak digunakan.
# Canon EOS R100 tanpa EDSDK: PTP melalui gPhoto2 (WSL pada Windows)
SNAPORE_CAMERA_PTP_MODE="wsl"
SNAPORE_GPHOTO2_PATH="gphoto2"
SNAPORE_GPHOTO2_WSL_DISTRO=""
SNAPORE_GPHOTO2_IMAGE_FORMAT=""
SNAPORE_CAMERA_USBIPD_AUTO_ATTACH="true"
# EOS R100 diprioritaskan dan di-hot-switch otomatis ketika tersambung.
SNAPORE_CAMERA_PREFERRED_MODEL="EOS R100"
SNAPORE_CAMERA_AUTO_SWITCH="true"
SNAPORE_CAMERA_CAPTURE_TIMEOUT_MS="45000"
# Bridge vendor lain dengan protokol discover/connect/capture yang sama.
SNAPORE_CAMERA_SDK_BRIDGE=""
SNAPORE_CAMERA_SDK_KIND="VENDOR_SDK"
SESSION_SECRET="generate-a-random-32-byte-base64-secret"
APP_ENCRYPTION_KEY="generate-a-different-32-byte-base64-key"
SUPER_ADMIN_EMAIL="superadmin@snapore.local"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"
