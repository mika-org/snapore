DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/postgres?schema=public"
NEXT_PUBLIC_DEVICE_AGENT_URL="http://127.0.0.1:4545"
SNAPORE_AGENT_PORT="4545"
SNAPORE_DATA_DIR="./snapore-data"
SNAPORE_SERVER_URL="http://localhost:3000"
SNAPORE_SERVER_UPLOAD_DIR="./server-uploads"
SNAPORE_DEVICE_TOKEN="change-this-device-token"
SNAPORE_PRINTER_MODE="os-spooler"
# PowerShell Windows yang dipakai untuk discovery queue dan silent photo print.
SNAPORE_POWERSHELL_PATH="powershell.exe"
# Opsional: executable adapter vendor dengan command `print` dan argumen pada README.
SNAPORE_DNP_SDK_BRIDGE=""
SNAPORE_EPSON_SDK_BRIDGE=""
# Path executable bridge resmi Canon EDSDK. Kosongkan jika tidak digunakan.
SNAPORE_CANON_SDK_BRIDGE=""
# Bridge vendor lain dengan protokol discover/connect/capture yang sama.
SNAPORE_CAMERA_SDK_BRIDGE=""
SNAPORE_CAMERA_SDK_KIND="VENDOR_SDK"
SESSION_SECRET="generate-a-random-32-byte-base64-secret"
APP_ENCRYPTION_KEY="generate-a-different-32-byte-base64-key"
SUPER_ADMIN_EMAIL="superadmin@snapore.local"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"
