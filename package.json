{
  "name": "snapore-photobooth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "frames:generate": "node scripts/generate-frames.mjs",
    "voice:generate": "python scripts/generate-voiceovers.py",
    "agent:build": "tsc -p tsconfig.agent.json",
    "agent:dev": "npm run agent:build && node dist-agent/server.js",
    "agent:start": "npm run agent:build && node dist-agent/server.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "pg": "latest",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prisma": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
