# File ini disalin ke %APPDATA%\Snapore Desktop\snapore.env saat aplikasi pertama kali dibuka.
# Jangan memasukkan file hasil konfigurasi ke Git atau ke paket installer.

DATABASE_URL=""
SESSION_SECRET="__GENERATE_SESSION_SECRET__"
APP_ENCRYPTION_KEY="__GENERATE_ENCRYPTION_KEY__"
SNAPORE_DEVICE_TOKEN="__GENERATE_DEVICE_TOKEN__"

# Identitas kiosk yang akan dilaporkan ke server.
SNAPORE_BOOTH_CODE="BKK-001"

# Bridge lokal tetap hanya mendengarkan di 127.0.0.1:4545.
SNAPORE_PRINTER_MODE="os-spooler"
SNAPORE_POWERSHELL_PATH="powershell.exe"

# Opsional: path absolut executable bridge SDK vendor.
SNAPORE_DNP_SDK_BRIDGE=""
SNAPORE_EPSON_SDK_BRIDGE=""
SNAPORE_CANON_SDK_BRIDGE=""
SNAPORE_CAMERA_SDK_BRIDGE=""
SNAPORE_CAMERA_SDK_KIND="VENDOR_SDK"

# Hanya dipakai untuk bootstrap database, bukan untuk login harian aplikasi.
SUPER_ADMIN_EMAIL="superadmin@snapore.local"
SUPER_ADMIN_PASSWORD=""
